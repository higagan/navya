# Rendering
PDF_RENDER_DPI=400

# Primary OCR: Parinamika / Akshar Anveshini (IIT Bombay). It's a
# login-gated web app with no public API — set PARINAMIKA_MODE=file and
# PARINAMIKA_INPUT_DIR to a folder where you drop page-NNN.txt/.json files
# exported from their web UI. Leave PARINAMIKA_MODE unset to skip straight
# to Google Vision for every page. PARINAMIKA_MODE=cli/http are there for
# if IIT Bombay ever provides a real programmatic interface.
PARINAMIKA_MODE=
PARINAMIKA_INPUT_DIR=
PARINAMIKA_CLI_CMD=
PARINAMIKA_HTTP_URL=
PARINAMIKA_HTTP_API_KEY=

# Fallback OCR: Google Cloud Vision
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# LLM structuring/post-correction step (not OCR), routed through OpenRouter
OPENROUTER_API_KEY=
NAVYA_LLM_MODEL=anthropic/claude-sonnet-5

# Cross-check between primary and fallback engine
NAVYA_RUN_CROSS_CHECK=1
NAVYA_XCHECK_THRESHOLD=0.75
