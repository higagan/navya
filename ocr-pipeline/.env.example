# Rendering
PDF_RENDER_DPI=400

# Primary OCR: Parinamika / Akshar Anveshini (IIT Bombay).
# Set PARINAMIKA_MODE to "cli" or "http" once we know the real interface.
# Leave unset to skip straight to Google Vision for every page.
PARINAMIKA_MODE=
PARINAMIKA_CLI_CMD=
PARINAMIKA_HTTP_URL=
PARINAMIKA_HTTP_API_KEY=

# Fallback OCR: Google Cloud Vision
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# LLM structuring/post-correction step (not OCR), routed through OpenRouter
OPENROUTER_API_KEY=
NAVYA_LLM_MODEL=anthropic/claude-sonnet-5

# Cross-check between primary and fallback engine
NAVYA_RUN_CROSS_CHECK=1
NAVYA_XCHECK_THRESHOLD=0.75
